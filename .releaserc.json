{
  "branches": [
    "main"
  ],
  "tagFormat": "${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "parserOpts": {
          "noteKeywords": [
            "BREAKING CHANGE",
            "BREAKING CHANGES",
            "BREAKING"
          ]
        }
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "angular",
        "parserOpts": {
          "noteKeywords": [
            "BREAKING CHANGE",
            "BREAKING CHANGES",
            "BREAKING"
          ]
        },
        "writerOpts": {
          "commitsSort": [
            "subject",
            "scope"
          ]
        }
      }
    ],
    "@semantic-release/changelog",
    "@semantic-release/npm",
    [
      "semantic-release-haxelib",
      {
        "haxelibPublish": true,
        "additionalFiles": []
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "haxe build-godot.hxml -D godot_plugin_version=${nextRelease.version} && cp -R godot/addon/. dist/godot/addons/dropecho_noise/ && (cd dist/godot && zip -qr ../dropecho.noise-godot-${nextRelease.version}.zip addons)"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/dropecho.noise-godot-*.zip",
            "label": "Godot addon (dropecho.noise ${nextRelease.version}) — extract addons/ into your project"
          }
        ]
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "dist/**/*.{js,css}",
          "*.md",
          "package.json",
          "haxelib.json"
        ]
      }
    ]
  ],
  "preset": "angular"
}
