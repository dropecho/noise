-cp src
-cp test

-lib seedyrng
-lib dropecho.testing 
-lib utest
-D analyzer-optimize
-D analyzer-user-var-fusion
-w -WDeprecated

--macro include('', true, null, ['src'])

--each

--next
-lib hxnodejs
-D js-es=6
-js artifacts/js_test.cjs

 --next
-D unsafe
-D net-ver=50
-cs artifacts/cs_test

--next
-python artifacts/py_test.py

# --next
